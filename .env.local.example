# Copy this file to .env.local and fill in real values. Never commit .env.local.
# See docs/OPERATIONS.md for where each value comes from.

# Neon Postgres — the POOLED connection string (host contains "-pooler").
# Secret: never prefix it with NEXT_PUBLIC_.
DATABASE_URL=

# Login: create both with `npm run db:hash-password`.
# Keep the quotes — the hash and secret are secrets, do not commit or share them.
APP_PASSWORD_HASH=
SESSION_SECRET=

# Only needed for the one-time copy from Supabase (npm run db:migrate).
# Supabase's Postgres connection string ("Session pooler" if you have no IPv6).
# SUPABASE_DB_URL=
